# ============================================
# CAG Bus Booking - Production Environment
# ============================================
# Copy this file to backend/.env or set these
# as Render environment variables.
# ============================================

NODE_ENV=production
PORT=10000

# Database (cloud MySQL - e.g. Aiven, Railway, PlanetScale)
# Option A: Use individual connection params
DB_HOST=your-mysql-host.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=your-strong-password
DB_NAME=cag_bus_booking
DB_SSL=true

# Option B: Use a full connection URL (overrides individual params)
# DATABASE_URL=mysql://user:password@host:port/db?ssl-mode=REQUIRED

# JWT Secrets (change these to strong random values)
JWT_SECRET=replace-with-random-64-char-string
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=replace-with-different-random-64-char-string
ADMIN_JWT_EXPIRES_IN=1d

# Payment Gateway
PAYMENT_GATEWAY_KEY=sim_key_test_cag_2024
PAYMENT_GATEWAY_URL=https://your-app.onrender.com/api/payments/process

# CORS (your Render app URL)
CORS_ORIGIN=https://your-app.onrender.com
